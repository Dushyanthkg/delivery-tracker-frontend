# Backend base URL (REST + Socket.io share the same origin)
NEXT_PUBLIC_API_URL=http://localhost:4000
# Initial map centre "lat,lng" (matches the backend seed data)
NEXT_PUBLIC_DEFAULT_CENTER=12.9716,77.5946
# Optional: your own MapLibre style JSON (MapTiler / Stadia / Maputnik) for the "Brand" map style.
# Leave blank to use OpenFreeMap recoloured with the brand colours in src/components/map/theme.ts.
NEXT_PUBLIC_MAP_BRAND_STYLE_URL=
